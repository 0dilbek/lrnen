SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://lms.example.com
CORS_ALLOWED_ORIGINS=https://lms.example.com
PROTECTED_MEDIA_URL_TTL=7200
USE_X_ACCEL_REDIRECT=True
MAX_IMAGE_UPLOAD_SIZE=15728640
MAX_AUDIO_UPLOAD_SIZE=104857600
MAX_VIDEO_UPLOAD_SIZE=1073741824
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# AI APIs
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database (optional, default is sqlite)
# DATABASE_URL=postgres://user:password@db:5432/dbname
