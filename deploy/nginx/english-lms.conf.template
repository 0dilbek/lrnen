upstream english_lms_backend {
    server unix:/run/english-lms/gunicorn.sock;
}

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAMES__;
    server_tokens off;
    client_max_body_size 1100m;

    root "__APP_DIR__/frontend/dist";
    index index.html;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), display-capture=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_headers_hash_max_size 1024;
        proxy_headers_hash_bucket_size 128;
        include proxy_params;
        proxy_pass http://english_lms_backend;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }

    # Kitob, audio va boshqa dars fayllarining taxmin qilinadigan raw URL'lari yopiq.
    location ~ ^/static/(book|book2|book3|coursebooks|audio)/ {
        return 404;
    }

    location /static/ {
        alias "__APP_DIR__/staticfiles/";
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        return 404;
    }

    # Bu manzillarga faqat Django imzolangan tokenni tekshirgandan keyin o'tiladi.
    location /_protected_static/ {
        internal;
        alias "__APP_DIR__/static/";
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location /_protected_media/ {
        internal;
        alias "__APP_DIR__/media/";
        limit_except GET HEAD { deny all; }
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
